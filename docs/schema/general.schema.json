{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "general.schema.json",
  "title": "武将定义（generals.json 为该对象的数组）",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "name", "title", "faction", "role", "hp", "atk", "def", "spd", "basic", "ultimate", "look", "bio", "unlock"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
      "name": { "type": "string", "minLength": 2, "maxLength": 6 },
      "title": { "type": "string" },
      "faction": { "enum": ["shu", "wei"] },
      "role": { "enum": ["warrior", "strategist", "guardian", "support"] },
      "hp": { "type": "integer", "minimum": 100 },
      "atk": { "type": "integer", "minimum": 10 },
      "def": { "type": "integer", "minimum": 0 },
      "spd": { "type": "integer", "minimum": 50, "maximum": 200 },
      "basic": { "$ref": "common.schema.json#/definitions/skill" },
      "ultimate": { "$ref": "common.schema.json#/definitions/skill" },
      "look": { "$ref": "common.schema.json#/definitions/look" },
      "bio": { "type": "string" },
      "unlock": { "type": "string", "pattern": "^(start|stage-[0-9]{2})$" }
    }
  }
}
