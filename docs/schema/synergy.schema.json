{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "synergy.schema.json",
  "title": "羁绊定义（synergies.json）",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "name", "desc", "members", "bonus"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
      "name": { "type": "string", "minLength": 2, "maxLength": 8 },
      "desc": { "type": "string" },
      "members": { "type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true, "items": { "type": "string" } },
      "bonus": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "hp": { "type": "number", "minimum": 0, "maximum": 0.5 },
          "atk": { "type": "number", "minimum": 0, "maximum": 0.5 },
          "def": { "type": "number", "minimum": 0, "maximum": 0.5 },
          "spd": { "type": "number", "minimum": 0, "maximum": 0.5 }
        }
      },
      "combo": {
        "type": "object",
        "required": ["lead", "skill"],
        "additionalProperties": false,
        "properties": {
          "lead": { "type": "string" },
          "skill": { "$ref": "common.schema.json#/definitions/skill" }
        }
      }
    }
  }
}
