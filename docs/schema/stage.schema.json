{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stage.schema.json",
  "title": "关卡定义（stages.json）",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "chapter", "index", "name", "intro", "recommended", "enemies", "rewards"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^stage-[0-9]{2}$" },
      "chapter": { "type": "integer", "minimum": 1 },
      "index": { "type": "integer", "minimum": 1 },
      "name": { "type": "string" },
      "intro": { "type": "string" },
      "recommended": { "type": "integer", "minimum": 0 },
      "enemies": {
        "type": "array", "minItems": 1, "maxItems": 6,
        "items": {
          "type": "object",
          "required": ["unit", "slot", "level"],
          "additionalProperties": false,
          "properties": {
            "unit": { "type": "string" },
            "slot": { "type": "integer", "minimum": 0, "maximum": 5 },
            "level": { "type": "integer", "minimum": 1, "maximum": 30 }
          }
        }
      },
      "rewards": {
        "type": "object",
        "required": ["gold", "stones", "firstClearGold"],
        "additionalProperties": false,
        "properties": {
          "gold": { "type": "integer", "minimum": 0 },
          "stones": { "type": "integer", "minimum": 0 },
          "firstClearGold": { "type": "integer", "minimum": 0 },
          "unlockGeneral": { "type": "string" }
        }
      }
    }
  }
}
